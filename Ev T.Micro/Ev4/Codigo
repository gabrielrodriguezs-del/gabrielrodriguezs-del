.include "m328Pdef.inc"

;Salidas:
	ldi r16, (1<<PD2) | (1<<PD3) | (1<<PD4) | (1<<PD5) | (1<<PD6) | (1<<PD7)
	out DDRD, r16
	ldi r16, 0
	out PORTD, r16  ;Salidas

	ldi r16, (1<<PC0) | (1<<PC1) | (1<<PC2) | (1<<PC3) | (1<<PC4) | (1<<PC5) | (1<<PC6)
	out DDRC, r16      
	ldi r16, 0b001111111
	out PORTC, r16 ;Salidas

	ldi r16, (1<<PB0) | (1<<PB1) | (1<<PB2) | (1<<PB3)
	out DDRB, r16
	ldi r16, 0b00001111
	out PORTB, r16
	
;Entradas:
	ldi r16, (1<<PB4) | (1<<PB5)
	;out portb, r16
	
	;;;;;;;
	cbi DDRB, PB4
	cbi DDRB, PB5

	; Pull-up internas
	sbi PORTB, PB4
	sbi PORTB, PB5
	;;;;;;;;

	ldi r16, high(RAMEND)    ;Para rcall
	out SPH, r16
	
	ldi r16, low(RAMEND)
	out SPL, r16

;Nombres:
	.def Cambio = r16
	.def Dual = r17
	.def Filas = r18     ;C
	.def Columnas = r19  ;B
	;Mostrar 20
	;Prueba de error 21 y 22 son tiempo
	ldi Dual, 40
	ldi r16, 1
	ldi r17, 1
	 
	rjmp Elegir

