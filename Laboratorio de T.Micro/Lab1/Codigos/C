.include "m328Pdef.inc"


.org 0x0000
    rjmp RESET



RESET:

  
    ldi r16, LOW(RAMEND)
    out SPL, r16

    ldi r16, HIGH(RAMEND)
    out SPH, r16



    ldi r16, 0b00111111
    out DDRB, r16

    ldi r16, 0b11000000
    out DDRD, r16


    ldi r16, (1<<PD2) | (1<<PD3) | (1<<PD4)
    out PORTD, r16

    clr r16



ESPERAR:

    ; Botón SIGUIENTE
    sbis PIND, PD2
    rjmp SIGUIENTE

    ; Botón ANTERIOR
    sbis PIND, PD3
    rjmp ANTERIOR

    ; Botón SECUENCIA 1
    sbis PIND, PD4
    rjmp IR_SECUENCIA_1

    ; Ningún botón
    rjmp EJECUTAR_SECUENCIA


SIGUIENTE:

    ; Esperar antirrebote
    rcall DELAY_CORTO

    ; Verificar que continúa presionado
    sbis PIND, PD2
    rjmp SIGUIENTE_CONFIRMADO

    rjmp ESPERAR


SIGUIENTE_CONFIRMADO:

    inc r16

    cpi r16, 8
    brlo ESPERAR_SOLTAR

    clr r16


ESPERAR_SOLTAR:
    ; Esperar que se suelte PD2
    sbis PIND, PD2
    rjmp ESPERAR_SOLTAR

    rjmp EJECUTAR_SECUENCIA


ANTERIOR:

    rcall DELAY_CORTO

    ; Confirmar pulsación
    sbis PIND, PD3
    rjmp ANTERIOR_CONFIRMADO

    rjmp ESPERAR


ANTERIOR_CONFIRMADO:

    ; Si estamos en secuencia 1,
    ; pasar a secuencia 8
    tst r16
    brne RESTAR_SECUENCIA

    ldi r16, 7
    rjmp ESPERAR_SOLTAR_ANTERIOR


RESTAR_SECUENCIA:

    dec r16


ESPERAR_SOLTAR_ANTERIOR:

    ; Esperar liberación
    sbis PIND, PD3
    rjmp ESPERAR_SOLTAR_ANTERIOR

    rjmp EJECUTAR_SECUENCIA



IR_SECUENCIA_1:

    rcall DELAY_CORTO

    ; Confirmar pulsación
    sbis PIND, PD4
    rjmp SECUENCIA_1_CONFIRMADA

    rjmp ESPERAR


SECUENCIA_1_CONFIRMADA:

    clr r16

ESPERAR_SOLTAR_RESET:

    sbis PIND, PD4
    rjmp ESPERAR_SOLTAR_RESET

    rjmp EJECUTAR_SECUENCIA


EJECUTAR_SECUENCIA:

    cpi r16, 0
    breq SECUENCIA_1

    cpi r16, 1
    breq SECUENCIA_2

    cpi r16, 2
    breq SECUENCIA_3

    cpi r16, 3
    breq SECUENCIA_4

    cpi r16, 4
    breq SECUENCIA_5

    cpi r16, 5
    breq SECUENCIA_6

    cpi r16, 6
    breq SECUENCIA_7

    rjmp SECUENCIA_8


SECUENCIA_1:

    sbi PORTD, PD6
    rcall DELAY_1S
    cbi PORTD, PD6
    rcall COMPROBAR_BOTONES

    sbi PORTD, PD7
    rcall DELAY_1S
    cbi PORTD, PD7
    rcall COMPROBAR_BOTONES

    sbi PORTB, PB0
    rcall DELAY_1S
    cbi PORTB, PB0
    rcall COMPROBAR_BOTONES

    sbi PORTB, PB1
    rcall DELAY_1S
    cbi PORTB, PB1
    rcall COMPROBAR_BOTONES

    sbi PORTB, PB2
    rcall DELAY_1S
    cbi PORTB, PB2
    rcall COMPROBAR_BOTONES

    sbi PORTB, PB3
    rcall DELAY_1S
    cbi PORTB, PB3
    rcall COMPROBAR_BOTONES

    sbi PORTB, PB4
    rcall DELAY_1S
    cbi PORTB, PB4
    rcall COMPROBAR_BOTONES

    sbi PORTB, PB5
    rcall DELAY_1S
    cbi PORTB, PB5
    rcall COMPROBAR_BOTONES

    rjmp SECUENCIA_1


SECUENCIA_2:

    sbi PORTB, PB5
    rcall DELAY_1S
    cbi PORTB, PB5
    rcall COMPROBAR_BOTONES

    sbi PORTB, PB4
    rcall DELAY_1S
    cbi PORTB, PB4
    rcall COMPROBAR_BOTONES

    sbi PORTB, PB3
    rcall DELAY_1S
    cbi PORTB, PB3
    rcall COMPROBAR_BOTONES

    sbi PORTB, PB2
    rcall DELAY_1S
    cbi PORTB, PB2
    rcall COMPROBAR_BOTONES

    sbi PORTB, PB1
    rcall DELAY_1S
    cbi PORTB, PB1
    rcall COMPROBAR_BOTONES

    sbi PORTB, PB0
    rcall DELAY_1S
    cbi PORTB, PB0
    rcall COMPROBAR_BOTONES

    sbi PORTD, PD7
    rcall DELAY_1S
    cbi PORTD, PD7
    rcall COMPROBAR_BOTONES

    sbi PORTD, PD6
    rcall DELAY_1S
    cbi PORTD, PD6
    rcall COMPROBAR_BOTONES

    rjmp SECUENCIA_2


SECUENCIA_3:

    sbi PORTD, PD6
    rcall DELAY_1S
    cbi PORTD, PD6
    rcall COMPROBAR_BOTONES

    sbi PORTB, PB0
    rcall DELAY_1S
    cbi PORTB, PB0
    rcall COMPROBAR_BOTONES

    sbi PORTB, PB2
    rcall DELAY_1S
    cbi PORTB, PB2
    rcall COMPROBAR_BOTONES

    sbi PORTB, PB4
    rcall DELAY_1S
    cbi PORTB, PB4
    rcall COMPROBAR_BOTONES

    sbi PORTD, PD7
    rcall DELAY_1S
    cbi PORTD, PD7
    rcall COMPROBAR_BOTONES

    sbi PORTB, PB1
    rcall DELAY_1S
    cbi PORTB, PB1
    rcall COMPROBAR_BOTONES

    sbi PORTB, PB3
    rcall DELAY_1S
    cbi PORTB, PB3
    rcall COMPROBAR_BOTONES

    sbi PORTB, PB5
    rcall DELAY_1S
    cbi PORTB, PB5
    rcall COMPROBAR_BOTONES

    rjmp SECUENCIA_3


;========================================================
; SECUENCIA 4
; 8 - 6 - 4 - 2 - 7 - 5 - 3 - 1
;========================================================
SECUENCIA_4:

    sbi PORTB, PB5
    rcall DELAY_1S
    cbi PORTB, PB5
    rcall COMPROBAR_BOTONES

    sbi PORTB, PB3
    rcall DELAY_1S
    cbi PORTB, PB3
    rcall COMPROBAR_BOTONES

    sbi PORTB, PB1
    rcall DELAY_1S
    cbi PORTB, PB1
    rcall COMPROBAR_BOTONES

    sbi PORTD, PD7
    rcall DELAY_1S
    cbi PORTD, PD7
    rcall COMPROBAR_BOTONES

    sbi PORTB, PB4
    rcall DELAY_1S
    cbi PORTB, PB4
    rcall COMPROBAR_BOTONES

    sbi PORTB, PB2
    rcall DELAY_1S
    cbi PORTB, PB2
    rcall COMPROBAR_BOTONES

    sbi PORTB, PB0
    rcall DELAY_1S
    cbi PORTB, PB0
    rcall COMPROBAR_BOTONES

    sbi PORTD, PD6
    rcall DELAY_1S
    cbi PORTD, PD6
    rcall COMPROBAR_BOTONES

    rjmp SECUENCIA_4


SECUENCIA_5:

    sbi PORTD, PD6
    rcall DELAY_1S
    cbi PORTD, PD6
    rcall COMPROBAR_BOTONES

    sbi PORTB, PB5
    rcall DELAY_1S
    cbi PORTB, PB5
    rcall COMPROBAR_BOTONES

    sbi PORTD, PD7
    rcall DELAY_1S
    cbi PORTD, PD7
    rcall COMPROBAR_BOTONES

    sbi PORTB, PB4
    rcall DELAY_1S
    cbi PORTB, PB4
    rcall COMPROBAR_BOTONES

    sbi PORTB, PB0
    rcall DELAY_1S
    cbi PORTB, PB0
    rcall COMPROBAR_BOTONES

    sbi PORTB, PB3
    rcall DELAY_1S
    cbi PORTB, PB3
    rcall COMPROBAR_BOTONES

    sbi PORTB, PB1
    rcall DELAY_1S
    cbi PORTB, PB1
    rcall COMPROBAR_BOTONES

    sbi PORTB, PB2
    rcall DELAY_1S
    cbi PORTB, PB2
    rcall COMPROBAR_BOTONES

    rjmp SECUENCIA_5


SECUENCIA_6:

    sbi PORTB, PB1
    rcall DELAY_1S
    cbi PORTB, PB1
    rcall COMPROBAR_BOTONES

    sbi PORTB, PB2
    rcall DELAY_1S
    cbi PORTB, PB2
    rcall COMPROBAR_BOTONES

    sbi PORTB, PB0
    rcall DELAY_1S
    cbi PORTB, PB0
    rcall COMPROBAR_BOTONES

    sbi PORTB, PB3
    rcall DELAY_1S
    cbi PORTB, PB3
    rcall COMPROBAR_BOTONES

    sbi PORTD, PD7
    rcall DELAY_1S
    cbi PORTD, PD7
    rcall COMPROBAR_BOTONES

    sbi PORTB, PB4
    rcall DELAY_1S
    cbi PORTB, PB4
    rcall COMPROBAR_BOTONES

    sbi PORTD, PD6
    rcall DELAY_1S
    cbi PORTD, PD6
    rcall COMPROBAR_BOTONES

    sbi PORTB, PB5
    rcall DELAY_1S
    cbi PORTB, PB5
