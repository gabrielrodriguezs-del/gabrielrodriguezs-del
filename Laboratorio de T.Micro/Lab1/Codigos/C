.include "m328Pdef.inc"

.org 0x0000
    rjmp RESET

RESET:
    ldi r16, LOW(RAMEND)
    out SPL, r16
    ldi r16, HIGH(RAMEND)  
    out SPH, r16

    ; Leds (8 leds: PD6, PD7, PB0, PB1, PB2, PB3, PB4, PB5)
    ldi r16, (1<<PB0) | (1<<PB1) | (1<<PB2) | (1<<PB3) | (1<<PB4) | (1<<PB5)
    out DDRB, r16 

    ldi r16, (1<<PD6) | (1<<PD7)
    out DDRD, r16 

    ; Pulsadores (Pull-up activos en PD2, PD3, PD4)
    ldi r16, (1<<PD2) | (1<<PD3) | (1<<PD4)
    out PORTD, r16

    ; Estado inicial (0)
    clr r16
    rjmp ESPERAR_SOLTAR

ESPERAR_SOLTAR:
    sbis PIND, 2                       
    rjmp MasUno

    sbis PIND, 3
    rjmp MenosUno

    sbis PIND, 4
    rjmp Cero
    rjmp ESPERAR_SOL

ESPERAR_SOL:
    sbis PIND, 2
    rjmp ESPERAR_SOL

    sbis PIND, 3
    rjmp ESPERAR_SOL

    sbis PIND, 4
    rjmp ESPERAR_SOL

    rjmp Menu

MasUno:
    cpi r16, 7        ; Limite superior (Maximo 8 secuencias: 0 a 7)
    breq ESPERAR_SOL  ; Si ya es 7, no incrementa
    inc r16
    rjmp ESPERAR_SOL 

MenosUno:
    tst  r16          ; Detecta si es menor o igual a 0
    breq ESPERAR_SOL  
    dec r16
    rjmp ESPERAR_SOL

Cero:
    clr r16
    rjmp ESPERAR_SOL

Menu:                  
    cpi r16, 0
    brne CHECK_1
    rjmp Siccer
CHECK_1:
    cpi r16, 1
    brne CHECK_2
    rjmp Sicuno
CHECK_2:
    cpi r16, 2
    brne CHECK_3
    rjmp Sicdos
CHECK_3:
    cpi r16, 3
    brne CHECK_4
    rjmp Sictre
CHECK_4:
    cpi r16, 4
    brne CHECK_5
    rjmp Siccua
CHECK_5:
    cpi r16, 5
    brne CHECK_6
    rjmp Sicin
CHECK_6:
    cpi r16, 6
    brne CHECK_7
    rjmp Sicsei
CHECK_7:
    ldi r16, 7        ; Si no es de 0 a 6, se fuerza a 7
    rjmp Sicsie 

; -------------------------------------------------------------------------
; SECUENCIAS
; -------------------------------------------------------------------------

; Secuencia 0: 1 - 2 - 3 - 4 - 5 - 6 - 7 - 8
Siccer:  
    sbi PORTD, PD6
    rcall DELAY_1S
    cbi PORTD, PD6

    sbi PORTD, PD7
    rcall DELAY_1S
    cbi PORTD, PD7

    sbi PORTB, PB0
    rcall DELAY_1S
    cbi PORTB, PB0

    sbi PORTB, PB1
    rcall DELAY_1S
    cbi PORTB, PB1

    sbi PORTB, PB2
    rcall DELAY_1S
    cbi PORTB, PB2

    sbi PORTB, PB3
    rcall DELAY_1S
    cbi PORTB, PB3

    sbi PORTB, PB4
    rcall DELAY_1S
    cbi PORTB, PB4

    sbi PORTB, PB5
    rcall DELAY_1S
    cbi PORTB, PB5

    sbis PIND, 2
    rjmp MasUno
    sbis PIND, 3
    rjmp MenosUno
    sbis PIND, 4
    rjmp Cero
    rjmp Siccer

; Secuencia 1: 8 - 7 - 6 - 5 - 4 - 3 - 2 - 1
Sicuno:  
    sbi PORTB, PB5
    rcall DELAY_1S
    cbi PORTB, PB5

    sbi PORTB, PB4
    rcall DELAY_1S
    cbi PORTB, PB4

    sbi PORTB, PB3
    rcall DELAY_1S
    cbi PORTB, PB3

    sbi PORTB, PB2
    rcall DELAY_1S
    cbi PORTB, PB2

    sbi PORTB, PB1
    rcall DELAY_1S
    cbi PORTB, PB1

    sbi PORTB, PB0
    rcall DELAY_1S
    cbi PORTB, PB0

    sbi PORTD, PD7
    rcall DELAY_1S
    cbi PORTD, PD7

    sbi PORTD, PD6
    rcall DELAY_1S
    cbi PORTD, PD6

    sbis PIND, 2
    rjmp MasUno
    sbis PIND, 3
    rjmp MenosUno
    sbis PIND, 4
    rjmp Cero
    rjmp Sicuno

; Secuencia 2: 1 - 3 - 5 - 7 - 2 - 4 - 6 - 8 (Impares y Pares)
Sicdos:                 
    sbi PORTD, PD6
    rcall DELAY_1S
    cbi PORTD, PD6

    sbi PORTB, PB0
    rcall DELAY_1S
    cbi PORTB, PB0

    sbi PORTB, PB2
    rcall DELAY_1S
    cbi PORTB, PB2

    sbi PORTB, PB4
    rcall DELAY_1S
    cbi PORTB, PB4

    sbi PORTD, PD7
    rcall DELAY_1S
    cbi PORTD, PD7

    sbi PORTB, PB1
    rcall DELAY_1S
    cbi PORTB, PB1

    sbi PORTB, PB3
    rcall DELAY_1S
    cbi PORTB, PB3

    sbi PORTB, PB5
    rcall DELAY_1S
    cbi PORTB, PB5

    sbis PIND, 2
    rjmp MasUno
    sbis PIND, 3
    rjmp MenosUno
    sbis PIND, 4
    rjmp Cero
    rjmp Sicdos

; Secuencia 3: 8 - 6 - 4 - 2 - 7 - 5 - 3 - 1
Sictre:                 
    sbi PORTB, PB5
    rcall DELAY_1S
    cbi PORTB, PB5

    sbi PORTB, PB3
    rcall DELAY_1S
    cbi PORTB, PB3

    sbi PORTB, PB1
    rcall DELAY_1S
    cbi PORTB, PB1

    sbi PORTD, PD7
    rcall DELAY_1S
    cbi PORTD, PD7

    sbi PORTB, PB4
    rcall DELAY_1S
    cbi PORTB, PB4

    sbi PORTB, PB2
    rcall DELAY_1S
    cbi PORTB, PB2

    sbi PORTB, PB0
    rcall DELAY_1S
    cbi PORTB, PB0

    sbi PORTD, PD6
    rcall DELAY_1S
    cbi PORTD, PD6

    sbis PIND, 2
    rjmp MasUno
    sbis PIND, 3
    rjmp MenosUno
    sbis PIND, 4
    rjmp Cero
    rjmp Sictre

; Secuencia 4: 1 - 8 - 2 - 7 - 3 - 6 - 4 - 5
Siccua:              
    sbi PORTD, PD6
    rcall DELAY_1S
    cbi PORTD, PD6

    sbi PORTB, PB5
    rcall DELAY_1S
    cbi PORTB, PB5

    sbi PORTD, PD7
    rcall DELAY_1S
    cbi PORTD, PD7

    sbi PORTB, PB4
    rcall DELAY_1S
    cbi PORTB, PB4

    sbi PORTB, PB0
    rcall DELAY_1S
    cbi PORTB, PB0

    sbi PORTB, PB3
    rcall DELAY_1S
    cbi PORTB, PB3

    sbi PORTB, PB1
    rcall DELAY_1S
    cbi PORTB, PB1

    sbi PORTB, PB2
    rcall DELAY_1S
    cbi PORTB, PB2

    sbis PIND, 2
    rjmp MasUno
    sbis PIND, 3
    rjmp MenosUno
    sbis PIND, 4
    rjmp Cero
    rjmp Siccua

; Secuencia 5: 4 - 5 - 3 - 6 - 2 - 7 - 1 - 8
Sicin:
    sbi PORTB, PB1
    rcall DELAY_1S
    cbi PORTB, PB1

    sbi PORTB, PB2
    rcall DELAY_1S
    cbi PORTB, PB2

    sbi PORTB, PB0
    rcall DELAY_1S
    cbi PORTB, PB0

    sbi PORTB, PB3
    rcall DELAY_1S
    cbi PORTB, PB3

    sbi PORTD, PD7
    rcall DELAY_1S
    cbi PORTD, PD7

    sbi PORTB, PB4
    rcall DELAY_1S
    cbi PORTB, PB4

    sbi PORTD, PD6
    rcall DELAY_1S
    cbi PORTD, PD6

    sbi PORTB, PB5
    rcall DELAY_1S
    cbi PORTB, PB5

    sbis PIND, 2
    rjmp MasUno
    sbis PIND, 3
    rjmp MenosUno
    sbis PIND, 4
    rjmp Cero
    rjmp Sicin

; Secuencia 6: Parpadeo de bloques (1-4 Encendidos, luego 5-8)
Sicsei:
    sbi PORTD, PD6
    sbi PORTD, PD7
    sbi PORTB, PB0
    sbi PORTB, PB1
    rcall DELAY_1S
    cbi PORTD, PD6
    cbi PORTD, PD7
    cbi PORTB, PB0
    cbi PORTB, PB1

    sbi PORTB, PB2
    sbi PORTB, PB3
    sbi PORTB, PB4
    sbi PORTB, PB5
    rcall DELAY_1S
    cbi PORTB, PB2
    cbi PORTB, PB3
    cbi PORTB, PB4
    cbi PORTB, PB5

    sbis PIND, 2
    rjmp MasUno
    sbis PIND, 3
    rjmp MenosUno
    sbis PIND, 4
    rjmp Cero
    rjmp Sicsei

; Secuencia 7: Parpadeo General
Sicsie:
    sbi PORTD, PD6
    sbi PORTD, PD7
    sbi PORTB, PB0
    sbi PORTB, PB1
    sbi PORTB, PB2
    sbi PORTB, PB3
    sbi PORTB, PB4
    sbi PORTB, PB5
    rcall DELAY_1S

    cbi PORTD, PD6
    cbi PORTD, PD7
    cbi PORTB, PB0
    cbi PORTB, PB1
    cbi PORTB, PB2
    cbi PORTB, PB3
    cbi PORTB, PB4
    cbi PORTB, PB5
    rcall DELAY_1S

    sbis PIND, 2
    rjmp MasUno
    sbis PIND, 3
    rjmp MenosUno
    sbis PIND, 4
    rjmp Cero
    rjmp Sicsie

; -------------------------------------------------------------------------
; RUTINA DE RETARDO
; -------------------------------------------------------------------------
DELAY_1S:
    ldi  r18, 11
    ldi  r19, 38
    ldi  r20, 93
L1: dec  r20     
    brne L1
    dec  r19   
    brne L1
    dec  r18
    brne L1
    ret
