    rjmp SECUENCIA_6



SECUENCIA_7:

    sbi PORTD, PD6
    sbi PORTD, PD7
    sbi PORTB, PB0
    sbi PORTB, PB1

    rcall DELAY_1S

    cbi PORTD, PD6
    cbi PORTD, PD7
    cbi PORTB, PB0
    cbi PORTB, PB1

    rcall COMPROBAR_BOTONES

    sbi PORTB, PB2
    sbi PORTB, PB3
    sbi PORTB, PB4
    sbi PORTB, PB5

    rcall DELAY_1S

    cbi PORTB, PB2
    cbi PORTB, PB3
    cbi PORTB, PB4
    cbi PORTB, PB5

    rcall COMPROBAR_BOTONES

    rjmp SECUENCIA_7


SECUENCIA_8:

    ; Encender los 8 LEDs
    ldi r17, 0b00111111
    out PORTB, r17

    sbi PORTD, PD6
    sbi PORTD, PD7

    rcall DELAY_1S

    ; Apagar los 8 LEDs
    clr r17
    out PORTB, r17

    cbi PORTD, PD6
    cbi PORTD, PD7

    rcall DELAY_1S

    rcall COMPROBAR_BOTONES

    rjmp SECUENCIA_8



COMPROBAR_BOTONES:

    ; SIGUIENTE
    sbis PIND, PD2
    rjmp SIGUIENTE

    ; ANTERIOR
    sbis PIND, PD3
    rjmp ANTERIOR

    ; SECUENCIA 1
    sbis PIND, PD4
    rjmp IR_SECUENCIA_1

    ret

DELAY_1S:

    ldi r18, 11
    ldi r19, 38
    ldi r20, 93

L1:
    dec r20
    brne L1

    dec r19
    brne L1

    dec r18
    brne L1

    ret


DELAY_CORTO:

    ldi r21, 20

D1:
    ldi r22, 255

D2:
    dec r22
    brne D2

    dec r21
    brne D1

    ret
