.include "m328Pdef.inc"

.org 0x0000
    rjmp RESET

RESET:

    ldi r16, LOW(RAMEND)
    out SPL, r16
    ldi r16, HIGH(RAMEND)  ;Estudiar 
    out SPH, r16

                           ; Leds
    ldi r16, (1<<PB0) | (1<<PB1) | (1<<PB2) | (1<<PB3) | (1<<PB4) | (1<<PB5)
    out DDRB, r16 

    ldi r16, (1<<PD6) | (1<<PD7)
    out DDRD, r16 

                           ; Pulsadores
    ldi r16, (1<<PD2) | (1<<PD3) | (1<<PD4)
    out PORTD, r16

    ; Estado inicial (0)
    clr r16
    rjmp ESPERAR_SOLTAR ;Cambiar a LEERBOTONES

ESPERAR_SOLTAR: ;Cambiar a LEERBOTONES
    sbis PIND, 2                       ;Error al dejaro precionado despues del 0, pasa a FF
    rjmp MasUno

    sbis PIND, 3
    rjmp MenosUno

    sbis PIND, 4
    rjmp Cero
    rjmp ESPERAR_SOL

ESPERAR_SOL:
    sbis PIND, 2
    rjmp ESPERAR_SOL

    sbis PIND, 3
    rjmp ESPERAR_SOL

    sbis PIND, 4
    rjmp ESPERAR_SOL

    rjmp Menu

MasUno:
    inc r16
    rjmp ESPERAR_SOL ;El limitador de este esta en "Menu" 

MenosUno:
    tst  r16          ;Detecta si es menjor o igual a 0
    breq ESPERAR_SOL  ;se activa si es menor o igual a 0
    dec r16
    rjmp ESPERAR_SOL

Cero:
    clr r16
    rjmp ESPERAR_SOL
;

 ;PD6 PD7 PB0 PB1 PB2 PB3 PB4 PB5
;  1   2   3   4   5   6   7   8 x
;  8   7   6   5   4   3   2   1 x
;  1   3   5   7   2   4   6   8 x
;  8   6   4   2   7   5   3   1 x
;  1   8   2   7   3   6   4   5 x



Siccer:  ;  1   2   3   4   5   6   7   8 x
    sbi PORTD, PD6
    rcall DELAY_1S
    cbi PORTD, PD6

    sbi PORTD, PD7
    rcall DELAY_1S
    cbi PORTD, PD7

    sbi PORTB, PB0
    rcall DELAY_1S
    cbi PORTB, PB0

    sbi PORTB, PB1
    rcall DELAY_1S
    cbi PORTB, PB1

    sbi PORTB, PB2
    rcall DELAY_1S
    cbi PORTB, PB2

    sbi PORTB, PB3
    rcall DELAY_1S
    cbi PORTB, PB3

    sbi PORTB, PB4
    rcall DELAY_1S
    cbi PORTB, PB4

    sbi PORTB, PB5
    rcall DELAY_1S
    cbi PORTB, PB5

    sbis PIND, 2
    rjmp MasUno

    sbis PIND, 3
    rjmp MenosUno

    sbis PIND, 4
    rjmp Cero
    rjmp Siccer

Sicuno:  ;  8   7   6   5   4   3   2   1 x
    sbi PORTB, PB5
    rcall DELAY_1S
    cbi PORTB, PB5

    sbi PORTB, PB4
    rcall DELAY_1S
    cbi PORTB, PB4

    sbi PORTB, PB3
    rcall DELAY_1S
    cbi PORTB, PB3

    sbi PORTB, PB2
    rcall DELAY_1S
    cbi PORTB, PB2

    sbi PORTB, PB1
    rcall DELAY_1S
    cbi PORTB, PB1

    sbi PORTB, PB0
    rcall DELAY_1S
    cbi PORTB, PB0

    sbi PORTD, PD7
    rcall DELAY_1S
    cbi PORTD, PD7

    sbi PORTD, PD6
    rcall DELAY_1S
    cbi PORTD, PD6

    sbis PIND, 2
    rjmp MasUno

    sbis PIND, 3
    rjmp MenosUno

    sbis PIND, 4
    rjmp Cero
    rjmp Sicuno

Menu:                  ;Esta aqui porque teiene que estar cerca del codigo
    cpi r16, 0
    breq Siccer
;
    cpi r16, 1
    breq Sicuno
;
    cpi r16, 2
    breq Sicdos
;
    cpi r16, 3
    breq Sictre
;
    ldi r16, 4
    ;cpi r16, 4
    rjmp Siccua  ;Por si acaso, esta es la accion automatica 

Sicdos:                 ;  1   3   5   7   2   4   6   8 x
    sbi PORTD, PD6
    rcall DELAY_1S    ;1
    cbi PORTD, PD6

    sbi PORTB, PB0
    rcall DELAY_1S    ;3
    cbi PORTB, PB0

    sbi PORTB, PB2
    rcall DELAY_1S    ;5
    cbi PORTB, PB2

    sbi PORTB, PB4
    rcall DELAY_1S    ;7
    cbi PORTB, PB4

    sbi PORTD, PD7
    rcall DELAY_1S    ;2
    cbi PORTD, PD7

    sbi PORTB, PB1
    rcall DELAY_1S    ;4
    cbi PORTB, PB1

    sbi PORTB, PB3
    rcall DELAY_1S    ;6
    cbi PORTB, PB3

    sbi PORTB, PB5
    rcall DELAY_1S    ;8
    cbi PORTB, PB5

    sbis PIND, 2
    rjmp MasUno

    sbis PIND, 3
    rjmp MenosUno

    sbis PIND, 4
    rjmp Cero
    rjmp Sicdos

Sictre:                 ;  8   6   4   2   7   5   3   1
    sbi PORTB, PB5
    rcall DELAY_1S    ;8
    cbi PORTB, PB5

    sbi PORTB, PB3
    rcall DELAY_1S    ;6
    cbi PORTB, PB3

    sbi PORTB, PB1
    rcall DELAY_1S    ;4
    cbi PORTB, PB1

    sbi PORTD, PD7
    rcall DELAY_1S    ;2
    cbi PORTD, PD7

    sbi PORTB, PB4
    rcall DELAY_1S    ;7
    cbi PORTB, PB4

    sbi PORTB, PB2
    rcall DELAY_1S    ;5
    cbi PORTB, PB2

    sbi PORTB, PB0
    rcall DELAY_1S    ;3
    cbi PORTB, PB0

    sbi PORTD, PD6
    rcall DELAY_1S    ;1
    cbi PORTD, PD6

    sbis PIND, 2
    rjmp MasUno

    sbis PIND, 3
    rjmp MenosUno

    sbis PIND, 4
    rjmp Cero
    rjmp Sictre

Siccua:              ;  1   8   2   7   3   6   4   5
    sbi PORTD, PD6
    rcall DELAY_1S    ;1
    cbi PORTD, PD6

    sbi PORTB, PB5
    rcall DELAY_1S    ;8
    cbi PORTB, PB5

    sbi PORTD, PD7
    rcall DELAY_1S    ;2
    cbi PORTD, PD7

    sbi PORTB, PB4
    rcall DELAY_1S    ;7
    cbi PORTB, PB4

    sbi PORTB, PB0
    rcall DELAY_1S    ;3
    cbi PORTB, PB0

    sbi PORTB, PB3
    rcall DELAY_1S    ;6
    cbi PORTB, PB3

    sbi PORTB, PB1
    rcall DELAY_1S    ;4
    cbi PORTB, PB1

    sbi PORTB, PB2
    rcall DELAY_1S    ;5
    cbi PORTB, PB2

    sbis PIND, 2
    rjmp MasUno

    sbis PIND, 3
    rjmp MenosUno

    sbis PIND, 4
    rjmp Cero
    rjmp Siccua


DELAY_1S:         ;El nombre es incorrecto, el tiempo es 1/8Se´gundos
    ldi  r18, 11
    ldi  r19, 38
    ldi  r20, 93
L1: dec  r20    ;Segundos r20-1 
    brne L1
    dec  r19   
    brne L1
    dec  r18
    brne L1
    ret
