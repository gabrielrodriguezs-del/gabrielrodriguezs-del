.include "m328Pdef.inc"
.cseg
.org 0x0000

RJMP start

start:
	;PB0-PB5 como salidas (Segmentos A-F)
	LDI R16, 0b00111111
	OUT DDRB, R16

	;PD7 como salida (Segmento G)
	SBI DDRD, PD7

	;entradas
	CBI DDRD, PD2
	CBI DDRD, PD3
	CBI DDRD, PD4

	;Pull-up
	SBI PORTD, PD2
	SBI PORTD, PD3
	SBI PORTD, PD4

	;contador
	LDI R20, 0

	;mostrar 0
	RJMP MOSTRAR_0

LOOP:
	;boton +
	SBIS PIND, PD2
	RJMP BOTON_MAS

	SBIS PIND, PD3
	RJMP BOTON_MENOS

	SBIS PIND, PD4
	RJMP BOTON_RESET

	RJMP LOOP

BOTON_MAS:

    ; Antirrebote
    RCALL DELAY_ANTIRREBOTE

    ; Comprobar 
    SBIS PIND, PD2
    RJMP INCREMENTAR

    RJMP LOOP


INCREMENTAR:

    INC R20

    CPI R20, 10
    BRNE ESPERAR_SUELTA

    LDI R20, 0
   
ESPERAR_SUELTA:
	SBIS PIND, PD2
	RJMP ESPERAR_SUELTA

	RCALL DELAY_ANTIRREBOTE
	RJMP MOSTRAR

BOTON_MENOS:

    RCALL DELAY_ANTIRREBOTE

    SBIS PIND, PD3
    RJMP DECREMENTAR

    RJMP LOOP


DECREMENTAR:

    DEC R20

    CPI R20, 255
    BRNE ESPERAR_SUELTA_MENOS

    LDI R20, 9


ESPERAR_SUELTA_MENOS:

    ; Esperar hasta que se suelte
    SBIS PIND, PD3
    RJMP ESPERAR_SUELTA_MENOS

    ; Antirrebote 
    RCALL DELAY_ANTIRREBOTE

    RJMP MOSTRAR


BOTON_RESET:

    ; Antirrebote al presionar
    RCALL DELAY_ANTIRREBOTE

    ; Comprobar que sigue presionado
    SBIS PIND, PD4
    RJMP REINICIAR

    RJMP LOOP


REINICIAR:

    ; Reiniciar contador
    LDI R20, 0


ESPERAR_SUELTA_RESET:

    ; Esperar hasta que se suelte PD4
    SBIS PIND, PD4
    RJMP ESPERAR_SUELTA_RESET

    ; Antirrebote al soltar
    RCALL DELAY_ANTIRREBOTE

    RJMP MOSTRAR
MOSTRAR:
	CPI R20, 0
    BREQ MOSTRAR_0

    CPI R20, 1
    BREQ MOSTRAR_1

    CPI R20, 2
    BREQ MOSTRAR_2

    CPI R20, 3
    BREQ MOSTRAR_3

    CPI R20, 4
    BREQ MOSTRAR_4

    CPI R20, 5
    BREQ MOSTRAR_5

    CPI R20, 6
    BREQ MOSTRAR_6

    CPI R20, 7
    BREQ MOSTRAR_7

    CPI R20, 8
    BREQ MOSTRAR_8

    CPI R20, 9
    BREQ MOSTRAR_9

    RJMP LOOP

MOSTRAR_0:
	LDI R16, 0b00111111
	OUT PORTB, R16
	CBI PORTD, PD7
	RJMP LOOP

MOSTRAR_1:
	LDI R16, 0b00000110
	OUT PORTB, R16
	CBI PORTD, PD7
	RJMP LOOP

MOSTRAR_2:
	LDI R16, 0b00011011
	OUT PORTB, R16
	SBI PORTD, PD7
	RJMP LOOP

MOSTRAR_3:
	LDI R16, 0b00001111
	OUT PORTB, R16
	SBI PORTD, PD7
	RJMP LOOP

MOSTRAR_4:
    LDI R16, 0b00100110
    OUT PORTB, R16
    SBI PORTD, PD7
    RJMP LOOP

MOSTRAR_5:
    LDI R16, 0b00101101
    OUT PORTB, R16
    SBI PORTD, PD7
    RJMP LOOP

MOSTRAR_6:
    LDI R16, 0b00111101
    OUT PORTB, R16
    SBI PORTD, PD7
    RJMP LOOP

MOSTRAR_7:
    LDI R16, 0b00000111
    OUT PORTB, R16
    CBI PORTD, PD7
    RJMP LOOP

MOSTRAR_8:
    LDI R16, 0b00111111
    OUT PORTB, R16
    SBI PORTD, PD7
    RJMP LOOP

MOSTRAR_9:
    LDI R16, 0b00101111
    OUT PORTB, R16
    SBI PORTD, PD7
    RJMP LOOP

DELAY_ANTIRREBOTE:

	LDI R21, 100

L1:
	LDI R22, 250

L2:
	DEC R22
	BRNE L2

	DEC R21
	BRNE L1

	RET


FIN:
	RJMP FIN
