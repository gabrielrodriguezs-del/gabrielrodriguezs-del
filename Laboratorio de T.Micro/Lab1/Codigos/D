.include "m328Pdef.inc"

.org 0x0000
    rjmp RESET

RESET:
    ; Configurar el Stack Pointer
    ldi r16, LOW(RAMEND)
    out SPL, r16
    ldi r16, HIGH(RAMEND)
    out SPH, r16

    ; Configurar PB0 a PB4 como SALIDAS (LEDs)
    ldi r16, (1<<PB0) | (1<<PB1) | (1<<PB2) | (1<<PB3) | (1<<PB4)
    out DDRB, r16

    ; Activar resistencias Pull-Up en PD2 a PD6 (Entradas)
    ldi r16, (1<<PD2) | (1<<PD3) | (1<<PD4) | (1<<PD5) | (1<<PD6)
    out PORTD, r16

MAIN:
    ; 1. EXTRAER SELECTOR DE OPERACIÓN (PD2, PD3, PD4) -> r18
    in r18, PIND
    com r18             ; Invertimos (Interruptor cerrado = 1)
    lsr r18
    lsr r18
    andi r18, 0x07      ; Nos quedamos con el código del selector (0 a 7)

    ; 2. EXTRAER ENTRADA A (PD5) -> r16
    clr r16             ; Asumimos A = 0
    sbis PIND, PD5      ; Si PD5 está presionado/cerrado (está en 0 físico), salta
    ldi r16, 1          ; Si está en 0 físico -> A = 1

    ; 3. EXTRAER ENTRADA B (PD6) -> r17
    clr r17             ; Asumimos B = 0
    sbis PIND, PD6      ; Si PD6 está presionado/cerrado (está en 0 físico), salta
    ldi r17, 1          ; Si está en 0 físico -> B = 1

    ; 4. TABLA DE SALTOS DE LA ALU
    cpi r18, 0
    breq Cero
    cpi r18, 1
    breq Uno
    cpi r18, 2
    breq Dos
    cpi r18, 3
    breq Tres
    cpi r18, 4
    breq Cuatro
    cpi r18, 5
    breq Cinco
    cpi r18, 6
    breq Seis
    cpi r18, 7
    breq Siete
    rjmp MAIN

; ==============================================================================
; SUBRUTINAS DE LA ALU (000 A 111)
; Entradas: r16 = A (0 o 1), r17 = B (0 o 1)
; ==============================================================================

Cero:       ; 000: Clear
    clr r16
    rjmp ACT_FLAGS_LOGICAS

Uno:        ; 001: A - B
    sub r16, r17
    rjmp MOSTRAR

Dos:        ; 010: A + B
    add r16, r17
    rjmp MOSTRAR

Tres:       ; 011: A XOR B
    eor r16, r17
    rjmp ACT_FLAGS_LOGICAS

Cuatro:     ; 100: A AND B
    and r16, r17
    rjmp ACT_FLAGS_LOGICAS

Cinco:      ; 101: A OR B
    or r16, r17
    rjmp ACT_FLAGS_LOGICAS

Seis:       ; 110: A << 1
    lsl r16
    rjmp MOSTRAR

Siete:      ; 111: A + 1
    inc r16
    rjmp MOSTRAR

; ==============================================================================
; GESTIÓN DE BANDERAS Y MOSTRADO EN PORTB (5 LEDs)
; ==============================================================================

; Para operaciones lógicas que no afectan Carry/Negative automáticamente en SREG:
ACT_FLAGS_LOGICAS:
    clc                 ; Limpia Carry (C=0)
    tst r16             ; Evalúa si r16 es cero para actualizar Zero (Z)
    in r19, SREG
    rjmp EVALUAR_LEDS

MOSTRAR:
    in r19, SREG        ; Copia el registro de estado interno (contiene C, N, Z)

EVALUAR_LEDS:
    clr r20             ; r20 acumulará los bits para encender los LEDs en PORTB

    ; LED 0 (PB0) -> Resultado (Bit 0 de r16)
    sbrc r16, 0
    sbr r20, (1<<PB0)

; LED 1 (PB1) -> Flag Carry (C) 
    sbrc r19, 0        ;Este enciende cuando el carri es negativo
    sbr r20, (1<<PB1)   

    sbrc r16, 1       ;Este ensiende cuando el carry es positivo 
    sbr r20, (1<<PB1)

    ; LED 2 (PB2) -> Flag Negative (N)
    sbrc r19, SREG_N
    sbr r20, (1<<PB2)

    ; LED 3 (PB3) -> Flag Zero (Z)
    sbrc r19, SREG_Z
    sbr r20, (1<<PB3)

    ; LED 4 (PB4) -> Indicador de Operación Activa
    sbr r20, (1<<PB4)

    ; Enviar el estado final a los 5 LEDs
    out PORTB, r20
    rjmp MAIN
